{% set site_name = site_name | default('Letreco Green Living Guide') %}
<!DOCTYPE html>
<html lang="{{ language | default('en') }}">

<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>About Us | {{ site_name }}</title>
	<link href="https://fonts.googleapis.com/css?family=Montserrat:400,700%7CMuli:400,700" rel="stylesheet">
	<link type="text/css" rel="stylesheet" href="{{ asset_prefix | default('../') }}css/bootstrap.min.css">
	<link rel="stylesheet" href="{{ asset_prefix | default('../') }}css/font-awesome.min.css">
	<link type="text/css" rel="stylesheet" href="{{ asset_prefix | default('../') }}css/style.css">
</head>

<body class="information-page">
	<header id="header">
		{% include "partials/shared-header.njk" %}

		<div class="page-header">
			<div class="container">
				<div class="row">
					<div class="col-md-offset-1 col-md-10 text-center">
						<h1 class="text-uppercase">About Us</h1>
						<p class="lead">At <strong>{{ site_name }}</strong>, we deliver trusted, research-driven insights on sustainable living, renewable energy, eco-innovation, and environmental stewardship. Our mission is to help individuals and communities make informed decisions that support a cleaner, greener, and more resilient future.</p>
					</div>
				</div>
			</div>
		</div>
	</header>

	<main class="section">
		<div class="container information-content">
			<div class="row">
				<div class="col-md-5">
					<section class="section-row">
						<div class="section-title"><h2 class="title">Our Story</h2></div>
						<p>We founded <strong>{{ site_name }}</strong> with a clear purpose: to make reliable environmental knowledge accessible to everyone. Our editorial team researches global climate trends, evaluates green technologies, reviews renewable-energy solutions, and transforms complex ecological topics into practical, easy-to-understand content that empowers people to take meaningful climate action.</p>
						<blockquote class="blockquote">
							<p>A sustainable future begins with informed choices. At Letreco, we turn environmental data and scientific research into actionable insights that inspire responsible living.</p>
							<footer class="blockquote-footer">Editorial Team</footer>
						</blockquote>
					</section>
				</div>
				<div class="col-md-7">
					<section class="section-row">
						<div class="section-title"><h2 class="title">Our Vision</h2></div>
						<p>Our vision is to be a trusted global platform for sustainability education and green innovation. By covering topics from clean energy breakthroughs and environmental policy to low-carbon lifestyles, we aim to help readers stay informed and contribute confidently to a more sustainable world.</p>
						<p>The future of {{ site_name }} is about innovation and trust. We will continue expanding category coverage, enhancing resource quality, and providing a clean, fast, and reliable reading experience for learners worldwide.</p>
					</section>
				</div>
			</div>
		</div>
	</main>

	{% include "partials/shared-footer.njk" %}

	<script src="{{ asset_prefix | default('../') }}js/jquery.min.js"></script>
	<script src="{{ asset_prefix | default('../') }}js/bootstrap.min.js"></script>
	<script src="{{ asset_prefix | default('../') }}js/jquery.stellar.min.js"></script>
	<script src="{{ asset_prefix | default('../') }}js/main.js"></script>
</body>

</html>
