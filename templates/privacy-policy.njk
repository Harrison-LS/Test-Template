{% set home_url = home_url | default('index.html') %}
{% set about_url = about_url | default('about.html') %}
{% set contact_url = contact_url | default('contact.html') %}
{% set privacy_url = privacy_url | default('privacy-policy.html') %}
<!DOCTYPE html>
<html lang="{{ language | default('en') }}">

<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{{ privacy.title | default('Privacy Policy') }} | San Francisco</title>
	<link href="https://fonts.googleapis.com/css?family=Montserrat:400,700%7CMuli:400,700" rel="stylesheet">
	<link type="text/css" rel="stylesheet" href="{{ asset_prefix | default('') }}css/bootstrap.min.css">
	<link rel="stylesheet" href="{{ asset_prefix | default('') }}css/font-awesome.min.css">
	<link type="text/css" rel="stylesheet" href="{{ asset_prefix | default('') }}css/style.css">
</head>

<body>
	<header id="header">
		{% include "partials/shared-header.njk" %}
	</header>

	<section class="privacy-hero">
		<div class="container">
			<h1>{{ privacy.title | default('Privacy Policy') }}</h1>
		</div>
	</section>

	<main class="container privacy-content">
		{% if privacy.sections %}
		{% for section in privacy.sections %}
		<section class="privacy-section">
			<h2 class="privacy-section-title">{{ section.title }}</h2>
			<div>{{ section.content | safe }}</div>
		</section>
		{% endfor %}
		{% else %}
		<section class="privacy-section">
			<h2 class="privacy-section-title">Introduction</h2>
			<p>At San Francisco Travel Guide, we respect your privacy and are committed to protecting your personal information. This Privacy Policy explains how we collect, use, and safeguard your data when you visit our website.</p>
		</section>
		<section class="privacy-section">
			<h2 class="privacy-section-title">Information We Collect</h2>
			<p><strong>Personal Information:</strong> Such as your name or email address, only when voluntarily provided through forms or subscriptions.</p>
			<p><strong>Non-Personal Information:</strong> Including browser type, device, IP address, and usage data for analytics and site improvement.</p>
			<p><strong>Cookies:</strong> We use cookies and similar technologies to enhance your browsing experience, measure traffic, and serve relevant content.</p>
		</section>
		<section class="privacy-section">
			<h2 class="privacy-section-title">How We Use Your Information</h2>
			<p>We use collected information to operate and improve the website, respond to inquiries, understand site usage, prevent misuse, and comply with legal obligations.</p>
		</section>
		<section class="privacy-section">
			<h2 class="privacy-section-title">Information Sharing</h2>
			<p>We do not sell your personal information. We may share limited data with service providers that help us operate the website, or when disclosure is required by law.</p>
		</section>
		<section class="privacy-section">
			<h2 class="privacy-section-title">Data Security</h2>
			<p>We use reasonable safeguards to protect your information. However, no internet transmission or storage system can be guaranteed to be completely secure.</p>
		</section>
		<section class="privacy-section">
			<h2 class="privacy-section-title">Third-Party Links</h2>
			<p>Our website may link to third-party websites. Their privacy practices are governed by their own policies, and we are not responsible for their content or practices.</p>
		</section>
		<section class="privacy-section">
			<h2 class="privacy-section-title">Changes to This Policy</h2>
			<p>We may update this Privacy Policy from time to time. Any changes will be published on this page with the revised effective date.</p>
		</section>
		<section class="privacy-section">
			<h2 class="privacy-section-title">Contact Us</h2>
			<p>If you have questions about this Privacy Policy, please contact us through our contact page.</p>
		</section>
		{% endif %}
	</main>

	{% include "partials/shared-footer.njk" %}

	<script src="{{ asset_prefix | default('') }}js/jquery.min.js"></script>
	<script src="{{ asset_prefix | default('') }}js/bootstrap.min.js"></script>
	<script src="{{ asset_prefix | default('') }}js/jquery.stellar.min.js"></script>
	<script src="{{ asset_prefix | default('') }}js/main.js"></script>
</body>

</html>
