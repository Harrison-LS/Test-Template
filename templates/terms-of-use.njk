{% set site_name = site_name | default('Letreco Green Living Guide') %}
{% set support_email = support_email | default('support@Letreco.onl') %}
<!DOCTYPE html>
<html lang="{{ language | default('en') }}">

<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Terms of Use | {{ site_name }}</title>
	<link href="https://fonts.googleapis.com/css?family=Montserrat:400,700%7CMuli:400,700" rel="stylesheet">
	<link type="text/css" rel="stylesheet" href="{{ asset_prefix | default('../') }}css/bootstrap.min.css">
	<link rel="stylesheet" href="{{ asset_prefix | default('../') }}css/font-awesome.min.css">
	<link type="text/css" rel="stylesheet" href="{{ asset_prefix | default('../') }}css/style.css">
</head>

<body class="information-page">
	<header id="header">
		{% include "partials/shared-header.njk" %}

		<div class="page-header">
			<div class="container">
				<div class="row">
					<div class="col-md-offset-1 col-md-10 text-center">
						<h1 class="text-uppercase">Terms of Use</h1>
					</div>
				</div>
			</div>
		</div>
	</header>

	<main class="section terms-content">
		<div class="container information-content">
			<section class="section-row">
				<div class="section-title"><h2 class="title">Introduction</h2></div>
				<p>Welcome to {{ site_name }}. By accessing or using our website, you agree to comply with and be bound by these Terms of Use. Please read them carefully before using our services.</p>
			</section>

			<section class="section-row">
				<div class="section-title"><h2 class="title">Website Content</h2></div>
				<p>The information provided on {{ site_name }} is for general informational purposes only. While we aim to ensure accuracy, we do not guarantee that all real estate or financial information is complete or up-to-date. Users should seek professional advice before making property or investment decisions.</p>
			</section>

			<section class="section-row">
				<div class="section-title"><h2 class="title">Intellectual Property</h2></div>
				<p>All content on this site, including text, images, graphics, and design, is owned by {{ site_name }} or its licensors, unless otherwise stated. You may not copy, reproduce, or distribute any content without prior written permission.</p>
			</section>

			<section class="section-row">
				<div class="section-title"><h2 class="title">Acceptable Use</h2></div>
				<p>You agree not to use this website for unlawful or prohibited purposes.</p>
				<p>You may not attempt to gain unauthorized access to our systems or data.</p>
				<p>You may share links to our content, provided proper credit is given to {{ site_name }}.</p>
			</section>

			<section class="section-row">
				<div class="section-title"><h2 class="title">Advertising &amp; Third-Party Links</h2></div>
				<p>{{ site_name }} uses Google AdSense and Google AdX to display advertisements. These ads may use cookies to deliver personalized advertising. We are not responsible for the content, accuracy, or practices of third-party websites or advertisers linked from our platform.</p>
			</section>

			<section class="section-row">
				<div class="section-title"><h2 class="title">Limitation of Liability</h2></div>
				<p>{{ site_name }} shall not be held liable for any damages resulting from the use or inability to use our website, including reliance on information provided on this site.</p>
			</section>

			<section class="section-row">
				<div class="section-title"><h2 class="title">Changes to Terms</h2></div>
				<p>We reserve the right to update or modify these Terms of Use at any time without prior notice. Continued use of the website after changes indicates acceptance of the updated terms.</p>
			</section>

			<section class="section-row">
				<div class="section-title"><h2 class="title">Contact Us</h2></div>
				<p>If you have questions regarding these Terms of Use, please contact us:<br>
					<strong>Email:</strong> <a href="mailto:{{ support_email }}">{{ support_email }}</a><br>
					<strong>Address:</strong> 1500 N Grant St, Ste R, Denver, CO 80203, USA
				</p>
			</section>
		</div>
	</main>

	{% include "partials/shared-footer.njk" %}

	<script src="{{ asset_prefix | default('../') }}js/jquery.min.js"></script>
	<script src="{{ asset_prefix | default('../') }}js/bootstrap.min.js"></script>
	<script src="{{ asset_prefix | default('../') }}js/jquery.stellar.min.js"></script>
	<script src="{{ asset_prefix | default('../') }}js/main.js"></script>
</body>

</html>
