{% import "partials/post-macros.njk" as posts %}
		<!-- NAV -->
		<div id="nav">
			<!-- Top Nav -->
			<div id="nav-top">
				<div class="container">
					<!-- logo -->
					<div class="nav-logo">
						<a href="index.html" class="logo brand-text"><span class="brand-pink">S</span>an <span class="brand-blue">F</span>rancisc<span class="brand-gold">o</span></a>
					</div>
					<!-- /logo -->

					<!-- search & aside toggle -->
					<div class="nav-btns">
						<button class="aside-btn"><i class="fa fa-bars"></i></button>
						<button class="search-btn"><i class="fa fa-search"></i></button>
						<div id="nav-search">
							<form>
								<input class="input" name="search" placeholder="Enter your search...">
							</form>
							<button class="nav-close search-close">
								<span></span>
							</button>
						</div>
					</div>
					<!-- /search & aside toggle -->
				</div>
			</div>
			<!-- /Top Nav -->

			<!-- Main Nav -->
			<div id="nav-bottom">
				<div class="container">
					<!-- nav -->
					<ul class="nav-menu">
						<li><a href="index.html">Home</a></li>
						<li class="has-dropdown megamenu">
							<a href="#">Travel</a>
							<div class="dropdown tab-dropdown">
								<div class="row">
									<div class="col-md-2">
										<ul class="tab-nav">
											<li class="active"><a data-toggle="tab" href="#tab1">Travel</a></li>
											<li><a data-toggle="tab" href="#tab2">Hotel</a></li>
											<li><a data-toggle="tab" href="#tab1">Restaurant</a></li>
										</ul>
									</div>
									<div class="col-md-10">
										<div class="dropdown-body tab-content">
											{% for tab in page.menuTabs %}
											<div id="{{ tab.id }}" class="tab-pane fade in{% if loop.first %} active{% endif %}">
												<div class="row">
													{% for post in tab.posts %}
													<div class="col-md-4">
														{{ posts.card(post, "post-sm", "title-sm") }}
													</div>
													{% endfor %}
												</div>
											</div>
											{% endfor %}
										</div>
									</div>
								</div>
							</div>
						</li>
						<li><a href="#">Hotel</a></li>
						<li><a href="#">Restaurant</a></li>
					</ul>
					<!-- /nav -->
				</div>
			</div>
			<!-- /Main Nav -->

			<!-- Aside Nav -->
			<div id="nav-aside">
				<ul class="nav-aside-menu">
					<li><a href="index.html">Home</a></li>
					<li class="has-dropdown"><a>Categories</a>
						<ul class="dropdown">
							<li><a href="#">Travel</a></li>
							<li><a href="#">Hotel</a></li>
							<li><a href="#">Restaurant</a></li>
						</ul>
					</li>
					<li><a href="about.html">About Us</a></li>
					<li><a href="contact.html">Contacts</a></li>
				</ul>
				<button class="nav-close nav-aside-close"><span></span></button>
			</div>
			<!-- /Aside Nav -->
		</div>
		<!-- /NAV -->
